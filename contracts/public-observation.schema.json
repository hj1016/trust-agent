{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustagent.local/contracts/public-observation.schema.json",
  "title": "TrustAgent Public KB Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_class", "synthetic", "observation_id", "collection_attempt_id", "collection_run_id", "product_key", "source_url", "final_url", "observed_at", "acquisition_method", "snapshot_manifest_path", "snapshot_hash"],
  "properties": {
    "dataset_class": {"const": "PUBLIC_KB"},
    "synthetic": {"const": false},
    "observation_id": {"type": "string", "pattern": "^obs:[a-z0-9-]+:[a-f0-9]{32}$"},
    "collection_attempt_id": {"type": "string", "pattern": "^collect:[a-z0-9-]+:[a-f0-9]{32}$"},
    "collection_run_id": {"type": "string", "pattern": "^run:[a-f0-9]{32}$"},
    "product_key": {"enum": ["small-business-credit", "boss-plus-overdraft", "kb-seller-loan"]},
    "source_url": {"type": "string", "pattern": "^https://([a-z0-9-]+\\.)*kbstar\\.com/"},
    "final_url": {"type": ["string", "null"], "pattern": "^https://([a-z0-9-]+\\.)*kbstar\\.com/"},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "acquisition_method": {"enum": ["HTTP_DOWNLOAD", "MANUAL_DOWNLOAD"]},
    "acquisition_note": {"type": "string", "minLength": 1},
    "snapshot_manifest_path": {"type": "string", "pattern": "^datasets/public/kb/manifests/[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-z0-9-]+.*\\.manifest\\.json$"},
    "snapshot_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"acquisition_method": {"const": "MANUAL_DOWNLOAD"}}, "required": ["acquisition_method"]}, "then": {"required": ["acquisition_note"]}},
    {"if": {"properties": {"acquisition_method": {"const": "HTTP_DOWNLOAD"}}, "required": ["acquisition_method"]}, "then": {"not": {"required": ["acquisition_note"]}}}
  ]
}
