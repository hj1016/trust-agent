{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustagent.local/contracts/synthetic-approved-checklist-fixture.schema.json",
  "title": "TrustAgent Synthetic Approved Checklist Fixture",
  "description": "test/demo 전용 승인 checklist 예시 데이터. origin은 FIXTURE로 고정되며 인간 승인 증거가 아니다. 검증, 사람 결정, 업무 사용 허용 조건을 우회하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_class", "synthetic", "disclaimer", "origin", "approved_checklist_version_id", "family_id", "notice_id", "created_at", "items"],
  "properties": {
    "dataset_class": {"const": "SYNTHETIC_INTERNAL"},
    "synthetic": {"const": true},
    "disclaimer": {"type": "string", "minLength": 20},
    "origin": {"const": "FIXTURE"},
    "approved_checklist_version_id": {"type": "string", "pattern": "^approved-checklist:[a-f0-9]{32}$"},
    "family_id": {"type": "string", "pattern": "^SIN-[A-Z0-9-]+$"},
    "notice_id": {"type": "string", "pattern": "^SIN-[A-Z0-9-]+-V[1-9][0-9]*$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_order", "rule_key", "instruction", "evidence_required", "structured_change", "source_rule_version_id"],
        "properties": {
          "item_order": {"type": "integer", "minimum": 0},
          "rule_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "instruction": {"type": "string", "minLength": 1},
          "evidence_required": {"type": "boolean"},
          "structured_change": {"type": ["object", "null"]},
          "source_rule_version_id": {"type": ["string", "null"], "pattern": "^policy-rule:sha256:[a-f0-9]{64}$"}
        }
      }
    }
  }
}
