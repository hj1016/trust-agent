{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustagent.local/contracts/public-extraction-attempt.schema.json",
  "title": "TrustAgent Public KB Extraction Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_class", "extraction_attempt_id", "extraction_run_id", "observation_id", "product_key", "attempt_sequence", "attempted_at", "parser_version", "status", "product_terms_version_id", "version_evidence_id", "rate_quote_id", "error_code", "error_message"],
  "properties": {
    "dataset_class": {"const": "DERIVED"},
    "extraction_attempt_id": {"type": "string", "pattern": "^extract:[a-z0-9-]+:[a-f0-9]{32}$"},
    "extraction_run_id": {"type": "string", "pattern": "^run:[a-f0-9]{32}$"},
    "observation_id": {"type": "string", "pattern": "^obs:[a-z0-9-]+:[a-f0-9]{32}$"},
    "product_key": {"enum": ["small-business-credit", "boss-plus-overdraft", "kb-seller-loan"]},
    "attempt_sequence": {"type": "integer", "minimum": 1},
    "attempted_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "parser_version": {"type": "string", "pattern": "^public-kb-html-v[0-9]+$"},
    "status": {"enum": ["SUCCEEDED", "FAILED"]},
    "product_terms_version_id": {"type": ["string", "null"], "pattern": "^ptv:[a-z0-9-]+:sha256:[a-f0-9]{64}$"},
    "version_evidence_id": {"type": ["string", "null"], "pattern": "^evidence:[a-z0-9-]+:[a-f0-9]{32}$"},
    "rate_quote_id": {"type": ["string", "null"], "pattern": "^quote:[a-z0-9-]+:[a-f0-9]{32}$"},
    "error_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
    "error_message": {"type": ["string", "null"], "minLength": 1, "maxLength": 300}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]},
      "then": {"properties": {"product_terms_version_id": {"type": "string"}, "version_evidence_id": {"type": "string"}, "rate_quote_id": {"type": "string"}, "error_code": {"type": "null"}, "error_message": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
      "then": {"properties": {"product_terms_version_id": {"type": "null"}, "version_evidence_id": {"type": "null"}, "rate_quote_id": {"type": "null"}, "error_code": {"type": "string"}, "error_message": {"type": "string"}}}
    }
  ]
}
