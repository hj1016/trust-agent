{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-agent.local/contracts/tool-applicable-checklist.schema.json",
  "title": "Tool applicable_checklist response",
  "description": "AI 서비스용 읽기 전용 Tool 응답. 사용 허용 여부는 Core가 결정한다. usable=false면 approvedChecklist는 null이고 항목·근거 ID가 없다. 공문 본문, 규칙 원문, 검수자 ID, 변경안·검증 ID, 정책 입력 플래그는 포함하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["familyId", "datasetClass", "synthetic", "disclaimer", "businessDate", "evaluatedAt", "selectedNotice", "usable", "blockingReasons", "warningReasons", "approvedChecklist"],
  "properties": {
    "familyId": {"type": "string"},
    "datasetClass": {"const": "SYNTHETIC_INTERNAL"},
    "synthetic": {"const": true},
    "disclaimer": {"type": "string", "minLength": 1},
    "businessDate": {"type": "string", "format": "date"},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "selectedNotice": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["noticeId", "version", "title", "effectiveFrom", "effectiveTo"],
      "properties": {
        "noticeId": {"type": "string"},
        "version": {"type": "integer"},
        "title": {"type": "string"},
        "effectiveFrom": {"type": "string", "format": "date"},
        "effectiveTo": {"type": ["string", "null"], "format": "date"}
      }
    },
    "usable": {"type": "boolean"},
    "blockingReasons": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "warningReasons": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "approvedChecklist": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approvedChecklistVersionId", "origin", "decisionId", "effectiveFrom", "effectiveTo", "items"],
      "properties": {
        "approvedChecklistVersionId": {"type": "string", "pattern": "^approved-checklist:[a-f0-9]{32}$"},
        "origin": {"const": "HUMAN_REVIEW"},
        "decisionId": {"type": "string", "pattern": "^review-decision:[a-f0-9]{32}$"},
        "effectiveFrom": {"type": "string", "format": "date"},
        "effectiveTo": {"type": ["string", "null"], "format": "date"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "ruleKey", "instruction", "evidenceRequired", "structuredChange", "sourceRuleVersionId"],
            "properties": {
              "order": {"type": "integer", "minimum": 0},
              "ruleKey": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
              "instruction": {"type": "string", "minLength": 1},
              "evidenceRequired": {"type": "boolean"},
              "structuredChange": {"type": ["object", "null"]},
              "sourceRuleVersionId": {"type": "string", "pattern": "^policy-rule:sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"usable": {"const": false}}}, "then": {"properties": {"approvedChecklist": {"type": "null"}}}},
    {"if": {"properties": {"usable": {"const": true}}}, "then": {"properties": {"approvedChecklist": {"type": "object"}, "blockingReasons": {"maxItems": 0}}}}
  ]
}
