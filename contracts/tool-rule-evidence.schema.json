{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-agent.local/contracts/tool-rule-evidence.schema.json",
  "title": "Tool rule_evidence response",
  "description": "현재 사용 가능한 승인 checklist 항목의 근거 규칙 원문 한 건. 공문 본문 전체는 포함하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["familyId", "noticeId", "effectiveFrom", "ruleVersionId", "ruleKey", "evidenceText", "jsonPointer", "evidenceHash", "disclaimer"],
  "properties": {
    "familyId": {"type": "string"},
    "noticeId": {"type": "string"},
    "effectiveFrom": {"type": "string", "format": "date"},
    "ruleVersionId": {"type": "string", "pattern": "^policy-rule:sha256:[a-f0-9]{64}$"},
    "ruleKey": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "evidenceText": {"type": "string", "minLength": 1},
    "jsonPointer": {"type": "string", "pattern": "^/"},
    "evidenceHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
