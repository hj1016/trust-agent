{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustagent.local/contracts/public-version-evidence.schema.json",
  "title": "TrustAgent Public KB Product Terms Version Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_class", "synthetic", "version_evidence_id", "observation_id", "product_terms_version_id", "product_key", "snapshot_hash", "parser_version", "fact_evidence"],
  "properties": {
    "dataset_class": {"const": "PUBLIC_KB"}, "synthetic": {"const": false},
    "version_evidence_id": {"type": "string", "pattern": "^evidence:[a-z0-9-]+:[a-f0-9]{32}$"},
    "observation_id": {"type": "string", "pattern": "^obs:[a-z0-9-]+:[a-f0-9]{32}$"},
    "product_terms_version_id": {"type": "string", "pattern": "^ptv:[a-z0-9-]+:sha256:[a-f0-9]{64}$"},
    "product_key": {"enum": ["small-business-credit", "boss-plus-overdraft", "kb-seller-loan"]},
    "snapshot_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "parser_version": {"type": "string", "pattern": "^public-kb-html-v[0-9]+$"},
    "fact_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["fact_id", "locators"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^fact:[a-z0-9-]+:[a-z0-9_]+$"},
          "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceLocator"}}
        }
      }
    }
  },
  "$defs": {
    "sourceLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "selector", "label", "evidence_text", "evidence_hash", "snapshot_hash", "source_url"],
      "properties": {
        "strategy": {"enum": ["CSS_ATTRIBUTE", "LABELED_ADJACENT_TEXT", "CSS_TEXT_MATCH"]},
        "selector": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
        "evidence_text": {"type": "string", "minLength": 1}, "evidence_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "snapshot_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_url": {"type": "string", "pattern": "^https://([a-z0-9-]+\\.)*kbstar\\.com/"}
      }
    }
  }
}
