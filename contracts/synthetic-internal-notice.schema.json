{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustagent.local/contracts/synthetic-internal-notice.schema.json",
  "title": "TrustAgent Synthetic Internal Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_class",
    "synthetic",
    "disclaimer",
    "notice_id",
    "family_id",
    "version",
    "title",
    "issued_at",
    "effective_from",
    "status",
    "references",
    "checklist_changes"
  ],
  "properties": {
    "dataset_class": {"const": "SYNTHETIC_INTERNAL"},
    "synthetic": {"const": true},
    "disclaimer": {"type": "string", "minLength": 10},
    "notice_id": {"type": "string", "pattern": "^SIN-[A-Z0-9-]+-V[0-9]+$"},
    "family_id": {"type": "string", "pattern": "^SIN-[A-Z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date"},
    "effective_from": {"type": "string", "format": "date"},
    "status": {"enum": ["DRAFT", "APPROVED", "RETIRED"]},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_class", "product_key", "snapshot_hash"],
        "properties": {
          "dataset_class": {"const": "PUBLIC_KB"},
          "product_key": {"type": "string"},
          "snapshot_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "checklist_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "instruction", "evidence_required"],
        "properties": {
          "change_id": {"type": "string"},
          "instruction": {"type": "string", "minLength": 1},
          "evidence_required": {"type": "boolean"}
        }
      }
    }
  }
}
