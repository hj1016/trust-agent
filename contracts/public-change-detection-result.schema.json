{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustagent.local/contracts/public-change-detection-result.schema.json",
  "title": "TrustAgent Public KB Change Detection Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_class", "change_detection_result_id", "product_key", "observation_id", "previous_observation_id", "evaluated_at", "policy_version", "classifications", "supersedes_result_id"],
  "properties": {
    "dataset_class": {"const": "DERIVED"},
    "change_detection_result_id": {"type": "string", "pattern": "^change:[a-z0-9-]+:[a-f0-9]{64}$"},
    "product_key": {"enum": ["small-business-credit", "boss-plus-overdraft", "kb-seller-loan"]},
    "observation_id": {"type": "string", "pattern": "^obs:[a-z0-9-]+:[a-f0-9]{32}$"},
    "previous_observation_id": {"type": ["string", "null"], "pattern": "^obs:[a-z0-9-]+:[a-f0-9]{32}$"},
    "evaluated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "policy_version": {"const": "public-kb-change-v1"},
    "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["BASELINE_ESTABLISHED", "PRODUCT_TERMS_CHANGED", "RATE_QUOTE_CHANGED", "QUOTE_REFRESHED", "NO_SEMANTIC_CHANGE"]}},
    "supersedes_result_id": {"type": ["string", "null"], "pattern": "^change:[a-z0-9-]+:[a-f0-9]{64}$"}
  }
}
